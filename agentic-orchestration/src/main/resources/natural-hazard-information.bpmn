<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0rgvf72" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_1t5i73t">
    <bpmn:participant id="Participant_0re2b8f" name="Natural Hazard Information" processRef="NaturalHazardInformation" />
  </bpmn:collaboration>
  <bpmn:process id="NaturalHazardInformation" name="Natural Hazard Information" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2" />
    </bpmn:extensionElements>
    <bpmn:sequenceFlow id="Flow_0vr6qp2" sourceRef="StartEvent_1" targetRef="enterCity" />
    <bpmn:sequenceFlow id="Flow_175eb8d" sourceRef="enterCity" targetRef="Gateway_0w72q9i" />
    <bpmn:sequenceFlow id="Flow_1qsjlcb" sourceRef="Gateway_0w72q9i" targetRef="determineCurrentDataOfRelevantNaturalHazards" />
    <bpmn:sequenceFlow id="Flow_1pt03uf" sourceRef="determineCurrentDataOfRelevantNaturalHazards" targetRef="readHazardInformation" />
    <bpmn:sequenceFlow id="Flow_15b0htn" sourceRef="readHazardInformation" targetRef="Event_0fyne8e" />
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0vr6qp2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="enterCity" name="enter City">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_inputTravel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vr6qp2</bpmn:incoming>
      <bpmn:outgoing>Flow_175eb8d</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0w72q9i">
      <bpmn:incoming>Flow_175eb8d</bpmn:incoming>
      <bpmn:outgoing>Flow_1qsjlcb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="readHazardInformation" name="read hazard information">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_bookTravel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pt03uf</bpmn:incoming>
      <bpmn:outgoing>Flow_15b0htn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0fyne8e">
      <bpmn:incoming>Flow_15b0htn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:adHocSubProcess id="determineCurrentDataOfRelevantNaturalHazards" name="determine current data of relevant natural hazards" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="completions" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="http://ollama.ollama.svc.cluster.local:11434/v1" target="provider.openai.backend.custom.endpoint" />
          <zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" />
          <zeebe:input source="not-needed" target="provider.openai.backend.custom.authentication.apiKey" />
          <zeebe:input source="qwen2.5:3b-instruct" target="provider.openai.model.model" />
          <zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" />
          <zeebe:input source="=0.1" target="provider.openai.api.completions.temperature" />
          <zeebe:input source="=&#34;You are a helpful assistant and answering in a brief style.&#10;First estimate roughly with your existing knowledge and WIHOUT TOOL CALLS which of the natural hazards of earthquake, volcano, tsunami, avalanche threatens the city of &#34; + city + &#34; with a high probability compared to major cities in the world. &#10;Then call only for relevant natural hazards for the city of &#34; + city + &#34; the corresponding tool to retrieve the current risk.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=city" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=5" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qsjlcb</bpmn:incoming>
      <bpmn:outgoing>Flow_1pt03uf</bpmn:outgoing>
      <bpmn:scriptTask id="currentVolcanoEruptionRiskTool" name="Current Volcano Risk Tool">
        <bpmn:documentation>Delivers the current risk of volcano eruptions risk for a given city.
Use it if the city is in a zone of subduction.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;1% possibility of an volcano eruption.&#34;" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.city, &#34;The city for which the volcano eruption possibility is to be determined&#34;)" target="city" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="currentTsunamiRiskTool" name="Current Tsunami Risk Tool">
        <bpmn:documentation>Delivers the current risk of Tsunami Waves for a given city.
Use it if the city faces the open sea and this part of the open sea is in a zone of subduction.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;5% possibility of an tsunami&#34;" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.city, &#34;The city for which the tsunami possibility is to be determined&#34;)" target="city" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="currentAvalancheRiskTool" name="Current Avalanche Risk Tool">
        <bpmn:documentation>Delivers the current risk of Avalanches for a given city.
Use it if the the city is in the near of high mountains.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;10% possibility of a avalanche&#34;" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.city, &#34;The city for which the avalanche possibility is to be determined&#34;)" target="city" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="currentEarthquakeRiskTool" name="Current Earthquake Risk Tool">
        <bpmn:documentation>Delivers the current risk of earthquakes for a given city.
Use it if the city is in a zone of subduction.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;20% possibility of an earthquake with a magnitude above level 4.0.&#34;" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.city, &#34;The city for which the earthquake possibility is to be determined&#34;)" target="city" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1t5i73t">
