        <dc:Bounds x="160" y="110" width="860" height="610" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="212" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1h0i0io_di" bpmnElement="enterCity">
        <dc:Bounds x="290" y="140" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0w72q9i_di" bpmnElement="Gateway_0w72q9i" isMarkerVisible="true">
        <dc:Bounds x="435" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1cz3ec7_di" bpmnElement="readHazardInformation">
        <dc:Bounds x="800" y="140" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0fyne8e_di" bpmnElement="Event_0fyne8e">
        <dc:Bounds x="952" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0mhpx5m_di" bpmnElement="determineCurrentDataOfRelevantNaturalHazards" isExpanded="true">
        <dc:Bounds x="530" y="140" width="230" height="550" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0jegt4n" bpmnElement="currentVolcanoEruptionRiskTool">
        <dc:Bounds x="600" y="320" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_01hqomk" bpmnElement="currentTsunamiRiskTool">
        <dc:Bounds x="600" y="440" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_0poew1r" bpmnElement="currentAvalancheRiskTool">
        <dc:Bounds x="600" y="560" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1oq19qc_di" bpmnElement="currentEarthquakeRiskTool">
        <dc:Bounds x="600" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0vr6qp2_di" bpmnElement="Flow_0vr6qp2">
        <di:waypoint x="248" y="180" />
        <di:waypoint x="290" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_175eb8d_di" bpmnElement="Flow_175eb8d">
        <di:waypoint x="390" y="180" />
        <di:waypoint x="435" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1qsjlcb_di" bpmnElement="Flow_1qsjlcb">
        <di:waypoint x="485" y="180" />
        <di:waypoint x="530" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1pt03uf_di" bpmnElement="Flow_1pt03uf">
        <di:waypoint x="760" y="180" />
        <di:waypoint x="800" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15b0htn_di" bpmnElement="Flow_15b0htn">
        <di:waypoint x="900" y="180" />
        <di:waypoint x="952" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
